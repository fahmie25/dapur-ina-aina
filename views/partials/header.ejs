<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' · Dapur Ina Aina' : 'Dapur Ina Aina' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<%- include('navbar') %>
<main>
  <div class="container">
    <% if (typeof success !== 'undefined' && success.length) { %>
      <% success.forEach(msg => { %>
        <div class="flash flash-success"><%= msg %></div>
      <% }) %>
    <% } %>
    <% if (typeof error !== 'undefined' && error.length) { %>
      <% error.forEach(msg => { %>
        <div class="flash flash-error"><%= msg %></div>
      <% }) %>
    <% } %>
